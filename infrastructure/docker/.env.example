# Compose / application-host configuration (infrastructure/docker/compose.yaml)
# Copy to .env and adjust. Never commit real secrets.

# Public URL of the application (used for CORS, redirects and Xendit callbacks).
PUBLIC_URL=http://localhost

# PostgreSQL server. Create the databases/roles with
# infrastructure/postgres/init.sh (local compose runs it automatically) and
# store passwords in infrastructure/secrets/.
DB_HOST=postgres
DB_PORT=5432
# prefer (default), require, verify-ca or verify-full. Use require+ for a
# managed/remote PostgreSQL server.
DB_SSLMODE=prefer

# Production only
TRAEFIK_ENTRYPOINTS=web
ACME_EMAIL=

# Google OAuth (identity-service)
GOOGLE_CLIENT_ID=

# Pusher (identity-service + frontend build)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_CLUSTER=ap1

# Xendit (payment-service)
XENDIT_BASE_URL=https://api.xendit.co
