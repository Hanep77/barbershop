# Compose / application-host configuration (infrastructure/docker/compose.yaml)
# Copy to .env and adjust. Never commit real secrets.

# Public URL of the application (used for CORS, redirects and Xendit callbacks).
PUBLIC_URL=http://localhost

# MySQL VM (separate host). Create the databases/users with
# infrastructure/mysql/init.sql and store passwords in infrastructure/secrets/.
DB_HOST=mysql-db
DB_PORT=3306

# Production only
TRAEFIK_ENTRYPOINTS=web
ACME_EMAIL=

# Google OAuth (identity-service)
GOOGLE_CLIENT_ID=

# Pusher (identity-service + frontend build)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_CLUSTER=ap1

# Xendit (payment-service)
XENDIT_BASE_URL=https://api.xendit.co
