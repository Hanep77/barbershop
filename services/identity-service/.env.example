APP_NAME=BarberBrody
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=prefer
DB_DATABASE=identity_db
DB_USERNAME=identity_user
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=null

INTERNAL_SERVICE_TOKEN=
INTERNAL_SERVICE_TIMEOUT=5
IDENTITY_SERVICE_URL=http://identity-service
CATALOG_SERVICE_URL=http://catalog-service
BOOKING_SERVICE_URL=http://booking-service
PAYMENT_SERVICE_URL=http://payment-service

JWT_ISSUER=barberbrody-identity
JWT_AUDIENCE=barberbrody-api
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
FRONTEND_URL=http://localhost

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

CORS_ALLOWED_ORIGINS=http://localhost
